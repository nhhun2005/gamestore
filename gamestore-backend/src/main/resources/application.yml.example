spring:
  application:
    name: gamestore-backend
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/gamestore}
    username: ${DB_USERNAME:gamestore}
    password: ${DB_PASSWORD}
  flyway:
    enabled: true
    default-schema: public
    schemas: public
    locations: classpath:db/migration
    baseline-on-migrate: false
    clean-disabled: true
    validate-on-migrate: true
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        default_schema: public
  mail:
    host: ${MAIL_HOST:smtp.gmail.com}
    port: ${MAIL_PORT:587}
    username: ${MAIL_USERNAME}
    password: ${MAIL_PASSWORD}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
app:
  jwt:
    secret: ${JWT_SECRET}
    expiration-ms: ${JWT_EXPIRATION_MS:86400000}
  commerce:
    demo-topups-enabled: true # QR simulation only; set false to disable simulated credits.
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000}
cloudinary:
  url: ${CLOUDINARY_URL:}
